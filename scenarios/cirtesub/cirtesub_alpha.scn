			<joint name="alpha_axis_eR"/>
			<controller position_gain="1.0" velocity_gain="1.0" max_torque="1000.0"/>
			<initial position="0.0"/>
		</actuator>

		<sensor name="IMU" rate="10.0" type="imu">
			<range angular_velocity="10.0 10.0 5.0" linear_acceleration="10.0"/>
			<noise angle="0.1 0.1 0.5" angular_velocity="0.05" yaw_drift="0.001" linear_acceleration="0.1"/>
			<history samples="1"/>
			<origin xyz="0.1 0.0 0.0" rpy="0.0 0.0 0.0"/>
			<link name="Vehicle"/>
		</sensor>

		<sensor name="Odometry" rate="30.0" type="odometry">
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			<ros_publisher topic="/cirtesub/odometry"/>
			<link name="Vehicle"/>
		</sensor>

		<sensor name="dvl" rate="10.0" type="dvl">
			<specs beam_angle="22.5" beam_positive_z="false"/>
			<range velocity="3.75 3.75 3.75" altitude_min="0.05" altitude_max="50.0"/>
			<noise velocity_percent="1.01" velocity="0.0001" altitude="0.01"/>
			<history samples="1"/>
			<origin xyz="-0.175204 0.025424 -0.109382" rpy="0.0 0.0 0.0"/>
			<link name="Vehicle"/>
			<ros_publisher topic="/cirtesub/stonefish/dvl" altitude_topic="/cirtesub/stonefish/dvl/altitude"/>
		</sensor>

		<sensor name="camera_left" rate="60.0" type="camera">
			<specs resolution_x="1600" resolution_y="1200" horizontal_fov="82.0"/>
			<origin xyz="0.064934 -0.223 -0.028599" rpy="-1.5707963268 0.0 3.1415926536"/>
			<link name="Vehicle"/>
			<ros_publisher topic="/cirtesub/stonefish/left_camera"/>
		</sensor>

		<sensor name="camera_right" rate="60.0" type="camera">
			<specs resolution_x="1600" resolution_y="1200" horizontal_fov="82.0"/>
			<origin xyz="-0.065057 -0.222 -0.028599" rpy="-1.5707963268 0.0 3.1415926536"/>
			<link name="Vehicle"/>
			<ros_publisher topic="/cirtesub/stonefish/right_camera"/>
		</sensor>

		<sensor name="camera_down" rate="30.0" type="camera">
			<specs resolution_x="1920" resolution_y="1080" horizontal_fov="82.0"/>
			<origin xyz="0.186484 -0.004132 -0.148599" rpy="3.1415926536 0.0 3.1415926536"/>
			<link name="Vehicle"/>
			<ros_publisher topic="/cirtesub/stonefish/down_camera"/>
		</sensor>

        <world_transform xyz="1.0 1.0 1.0" rpy="0.0 3.14 0.0"/>

        <!-- Publicación de TF dinámico del base_link -->
		<!-- <ros_subscriber servos="/pez/servo_commands"/>
		<ros_publisher servos="/pez/joint_states"/> -->
		<ros_subscriber thrusters="/cirtesub/controller/thruster_setpoints_sim" forces="/cirtesub/controller/thruster_manager/input_stamped"/>
		<ros_publisher thrusters="/cirtesub/controller/thruster_state" forces="/cirtesub/controller/thruster_manager/output"/>
        <ros_base_link_transforms publish="true"/>
	</robot>
</scenario>
